            <subviews>
                <stackView opaque="NO" contentMode="scaleToFill" distribution="fillEqually" spacing="12" translatesAutoresizingMaskIntoConstraints="NO" id="tab-stk">
                    <rect key="frame" x="16" y="16" width="361" height="44"/>
                    <subviews>
