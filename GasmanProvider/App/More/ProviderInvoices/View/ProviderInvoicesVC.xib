                    </subviews>
                </stackView>
                <tableView clipsSubviews="YES" contentMode="scaleToFill" alwaysBounceVertical="YES" showsHorizontalScrollIndicator="NO" showsVerticalScrollIndicator="NO" estimatedRowHeight="120" rowHeight="-1" sectionHeaderHeight="0.0" estimatedSectionHeaderHeight="0.0" sectionFooterHeight="0.0" estimatedSectionFooterHeight="0.0" style="plain" separatorStyle="none" translatesAutoresizingMaskIntoConstraints="NO" id="inv-tv">
                    <rect key="frame" x="16" y="76" width="361" height="692"/>
