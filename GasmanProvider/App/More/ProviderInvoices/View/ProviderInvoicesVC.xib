                            <rect key="frame" x="0.0" y="0.0" width="174.66666666666666" height="44"/>
                            <constraints>
                                <constraint firstAttribute="height" constant="44" id="cst-tab-h"/>
                            </constraints>
                            <fontDescription key="fontDescription" type="system" pointSize="16"/>
