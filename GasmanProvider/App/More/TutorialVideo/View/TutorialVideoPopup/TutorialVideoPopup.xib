                <constraint firstItem="content-view" firstAttribute="centerY" secondItem="root-view" secondAttribute="centerY" id="cv-cy"/>
                <constraint firstItem="content-view" firstAttribute="leading" secondItem="root-view" secondAttribute="leading" constant="16" id="cv-l"/>
                <constraint firstItem="root-view" firstAttribute="trailing" secondItem="content-view" secondAttribute="trailing" constant="16" id="cv-tr"/>
